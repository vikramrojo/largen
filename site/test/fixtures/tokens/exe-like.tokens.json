    },
    "md": {
      "$value": {
        "value": 0.125,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "4": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "6": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    }
  },
  "speed": {
    "$type": "duration",
    "$value": {
      "value": 0.15,
      "unit": "s"
    }
