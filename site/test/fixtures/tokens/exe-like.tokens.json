{
  "$description": "A consumer theme shaped like exe's exe.theme.css: the largen vocabulary plus project extras. Not a real exe export.",
  "$extensions": {
    "dev.largen": {
      "dtcg": "2025.10",
      "theme": "exe",
      "colorScheme": "light"
    }
  },
  "canvas": {
