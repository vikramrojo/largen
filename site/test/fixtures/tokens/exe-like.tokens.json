    "$type": "dimension",
    "$value": {
      "value": 1,
      "unit": "rem"
    }
  },
  "line-height-base": {
    "$type": "dimension",
    "$value": {
      "value": 1.75,
      "unit": "rem"
    },
    "$description": "exe overrides largen's 1.55 ratio with an absolute line box. largen types this number, so import warns and emits it."
  },
  "font": {
    "$type": "fontFamily",
    "$description": "sanctioned exe extras; largen's own font.ui / font.mono are left alone",
    "tw": {
      "$value": [
        "Soehne",
        "system-ui",
        "sans-serif"
      ]
    },
    "control": {
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "text": {
    "$type": "dimension",
    "$description": "sanctioned exe extras: the project type ladder",
    "2xs": {
      "$value": {
        "value": 0.6875,
        "unit": "rem"
      }
    },
    "xs": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "display": {
      "$value": {
        "value": 5,
        "unit": "rem"
      },
      "$description": "page title; fluid in CSS, the fallback is the clamp ceiling",
      "$extensions": {
        "dev.largen": {
          "css": "clamp(2.5rem, 8vw, 5rem)"
        }
      }
    }
  },
  "leading": {
    "$type": "dimension",
    "28": {
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "40": {
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    }
  },
  "control": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    }
  },
  "tracking": {
    "$type": "dimension",
    "tight": {
      "$value": {
        "value": -0.01,
        "unit": "em"
      }
    },
    "wide": {
      "$value": {
        "value": 0.04,
        "unit": "em"
      }
    }
  },
  "measure-page": {
    "$type": "dimension",
    "$value": {
      "value": 72,
      "unit": "rem"
    }
  }
